<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:Time_Tracker.ViewModels"
		x:Class="Time_Tracker.Dialogs.ActivityHistoryWindow"
		x:DataType="vm:MainViewModel"
		Width="840"
		Height="480"
		MinWidth="720"
		MinHeight="420"
		WindowStartupLocation="CenterOwner"
		Title="Activity History">
	<Grid RowDefinitions="Auto,*,Auto" Margin="16">
		<StackPanel Grid.Row="0" Margin="0,0,0,12">
			<TextBlock FontSize="18" FontWeight="Bold" Text="{Binding SelectedActivity.Name}" />
			<TextBlock Opacity="0.75" Text="Edit or review the selected activity's recorded sessions." />
		</StackPanel>

		<DataGrid Grid.Row="1"
				  ItemsSource="{Binding TimeEntries}"
				  SelectedItem="{Binding SelectedTimeEntry}"
				  AutoGenerateColumns="False"
				  IsReadOnly="True"
				  CanUserSortColumns="True">
			<DataGrid.Columns>
				<DataGridTextColumn Header="Start" Binding="{Binding StartLocal}" Width="2*" />
				<DataGridTextColumn Header="End" Binding="{Binding EndLocal}" Width="2*" />
				<DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="*" />
				<DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
				<DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="2*" />
			</DataGrid.Columns>
		</DataGrid>

		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
			<Button Content="Edit Selected" Click="EditSelected_Click" />
			<Button Content="Delete Selected" Command="{Binding DeleteTimeEntryCommand}" />
			<Button Content="Close" Click="Close_Click" />
		</StackPanel>
	</Grid>
</Window>
