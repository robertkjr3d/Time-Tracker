<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Time_Tracker.Dialogs.ConfirmDeleteWindow"
        Width="480"
        Height="220"
        CanResize="False"
        Title="Confirm Delete">
    <Grid RowDefinitions="Auto,Auto,Auto" Margin="16">
        <TextBlock x:Name="HeadingTextBlock" FontSize="18" FontWeight="Bold" Text="Delete item?" />
        <TextBlock x:Name="MessageTextBlock" Grid.Row="1" Margin="0,12,0,0" TextWrapping="Wrap" Text="This action cannot be undone." />
        <StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="10">
            <TextBlock x:Name="TargetNameTextBlock" Opacity="0.75" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Click="Cancel_Click" />
                <Button x:Name="ConfirmButton" Content="Delete" Classes="accent" Click="Delete_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
