<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Time_Tracker.Dialogs.ExportScopeWindow"
        Width="420"
        Height="190"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Export CSV">
    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <TextBlock FontSize="16"
                   FontWeight="SemiBold"
                   Text="Export scope"
                   Foreground="#173042" />

        <TextBlock Grid.Row="1"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Text="Choose whether to export all jobs or only the currently selected job." />

        <StackPanel Grid.Row="2"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Content="Cancel" Click="Cancel_Click" />
            <Button Content="All jobs" Click="AllJobs_Click" />
            <Button Content="This job" Classes="accent" Click="ThisJob_Click" />
        </StackPanel>
    </Grid>
</Window>
